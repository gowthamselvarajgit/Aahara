# .env example
# Copy this file to .env and fill in the actual values.

# MySQL database credentials
DB_URL=jdbc:mysql://localhost:3306/aahara
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password_here

# Security Configuration
# Must be at least 256 bits (32 characters) for HS256
APP_JWT_SECRET=your_super_secret_jwt_signing_key_here
